  "device": "cuda",
  "precision": "bfloat16",
  "seed": 42,
  "save_masks": false,
  "offload_video_to_cpu": true,
  "offload_state_to_cpu": true,
  "max_videos": null,
  "bootstrap_samples": 10000,
  "checkpoints": {}
